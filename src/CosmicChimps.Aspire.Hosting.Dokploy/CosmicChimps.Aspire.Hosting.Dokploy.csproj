<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Aspire pipeline API (PipelineStepAnnotation, PipelineStep, etc.) is experimental -->
    <NoWarn>$(NoWarn);ASPIREPIPELINES001</NoWarn>

    <!-- NuGet package metadata -->
    <PackageId>CosmicChimps.Aspire.Hosting.Dokploy</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>aspire hosting dokploy docker deployment paas</PackageTags>
    <Description>Dokploy deployment integration for .NET Aspire — deploys each Aspire service as an individual Dokploy application or native managed resource (Redis, PostgreSQL, MySQL, MariaDB, MongoDB).</Description>
    <Authors>Cosmic Chimps</Authors>
    <Company>Cosmic Chimps</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Cosmic-Chimps/aspire-hosting-dokploy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cosmic-Chimps/aspire-hosting-dokploy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.5.3" />
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CosmicChimps.Aspire.Hosting.Dokploy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The repo-root README is the single source: it is the GitHub landing page AND the package
      readme. A second copy lived here and the two silently drifted for months — the root one was
      left at 292 lines while everything learned since went into this one.
    -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
  </ItemGroup>
</Project>
